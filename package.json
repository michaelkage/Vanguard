{
  "name": "vanguard",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "expo install --check"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "^58.0.0",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-status-bar": "^58.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.0.8"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
